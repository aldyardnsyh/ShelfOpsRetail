# =============================================================================
# ShelfOps — template .env PRODUKSI (VPS).
# bootstrap-vps.sh menyalin file ini menjadi .env lalu mengisi placeholder.
# Jangan commit file .env hasil salinan. Jangan menaruh nilai rahasia di sini.
# =============================================================================

APP_ENV=production
APP_BASE_URL=__APP_BASE_URL__
WEB_BASE_URL=__WEB_BASE_URL__
LOG_LEVEL=info

GATEWAY_MODE=all
GATEWAY_HTTP_ADDR=:8080
GATEWAY_SHUTDOWN_TIMEOUT=20s

SHELFOPS_HOST=__SHELFOPS_HOST__
WEB_DEMO_MODE=0
ADMIN_EMAIL=__ADMIN_EMAIL__
ADMIN_WORKSPACE=ShelfOps
ACME_EMAIL=__ACME_EMAIL__

POSTGRES_USER=shelfops
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=shelfops
DATABASE_URL=__DATABASE_URL__
DB_MAX_CONNS=10
MIGRATE_ON_START=true

JWT_SECRET=__JWT_SECRET__
SESSION_SECRET=__SESSION_SECRET__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=__COOKIE_DOMAIN__
COOKIE_SECURE=true
LOGIN_RATE_LIMIT_PER_MIN=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=__GOOGLE_REDIRECT_URL__

DEMO_ENABLED=true
DEMO_RESET_HOURS=24
DEMO_AI_REQUESTS_PER_HOUR=30

OBJECT_STORE_DRIVER=local
OBJECT_STORE_ROOT=/data/uploads
UPLOAD_TTL_HOURS=24
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOC_MB=20

LLM_PROVIDER=replay
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_DAILY_BUDGET_USD=1.00
LLM_REQUEST_TIMEOUT=45s

EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_BATCH=32

VLM_PROVIDER=off
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

RAG_LOG_LEVEL=info
RAG_HTTP_PORT=8081
RAG_GRPC_PORT=50051
RAG_EMBEDDING_DIM=256
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_N_FINAL=6
VISION_LOG_LEVEL=info
VISION_HTTP_PORT=8082
VISION_GRPC_PORT=50052

VISION_TIMEOUT=30s
VISION_DETECTOR=replay
VISION_MODEL_VERSION=replay-yolo-placeholder-v1
VISION_CONF_THRESHOLD=0.25
VISION_LOW_CONF_THRESHOLD=0.6
VISION_CONCURRENCY=1
VISION_BATCH_SIZE=8
VISION_BATCH_WAIT_MS=25
VISION_OCR_ENGINE=stub
VISION_MAX_IMAGE_BYTES=10485760

MODEL_DIR=/models
MODEL_IMGSZ=960

RATE_LIMIT_PER_MIN=300
QUEUE_MAX_DEPTH=10

TRACE_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
