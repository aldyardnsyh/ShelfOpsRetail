# =====================================================================
# ShelfOps — contoh konfigurasi. Salin ke .env dan isi. JANGAN commit .env.
# Semua nilai punya default aman untuk dev; produksi wajib mengubah secret.
# =====================================================================

# --- Umum -------------------------------------------------------------
APP_ENV=development                 # development | production | test
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info                      # debug | info | warn | error

# --- Web (Next.js) ----------------------------------------------------
# Kosong = same-origin (Docker satu domain, Caddy mem-proxy /api/*).
# Isi absolut hanya bila web dan API beda host, mis. https://api.example.com.
NEXT_PUBLIC_API_URL=
# 0 = production (butuh API URL atau same-origin) | 1 = demo statis tanpa backend
NEXT_PUBLIC_DEMO_MODE=0
WEB_DEMO_MODE=0                     # build image web Docker: 1 = demo statis
NEXT_PUBLIC_GIT_SHA=dev

# --- Deployment Docker (produksi) -------------------------------------
# WEB_BASE_URL dan APP_BASE_URL memakai host yang sama (satu domain).
SHELFOPS_HOST=shelfops.example.com  # domain publik tunggal (web + /api)
ACME_EMAIL=admin@example.com
# Admin pertama dibuat saat deploy (deploy.sh) atau `make bootstrap-prod`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_WORKSPACE=ShelfOps

# --- Gateway (Go) -----------------------------------------------------
GATEWAY_HTTP_ADDR=:8080
GATEWAY_MODE=all                    # api | worker | all
GATEWAY_SHUTDOWN_TIMEOUT=20s

# --- Database ---------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shelfops
POSTGRES_PASSWORD=shelfops_dev_password
POSTGRES_DB=shelfops
DATABASE_URL=postgres://shelfops:shelfops_dev_password@localhost:5432/shelfops?sslmode=disable
DB_MAX_CONNS=10
MIGRATE_ON_START=true

# --- Auth -------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789abcdef
SESSION_SECRET=dev-only-insecure-session-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=                      # kosong = satu host; isi .domain hanya bila web/API beda subdomain
COOKIE_SECURE=false                 # produksi: true
LOGIN_RATE_LIMIT_PER_MIN=10

# --- Google OAuth (opsional) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- Demo mode --------------------------------------------------------
DEMO_ENABLED=true
DEMO_RESET_HOURS=24
DEMO_AI_REQUESTS_PER_HOUR=30

# --- Object storage (LocalFS default) --------------------------------
OBJECT_STORE_DRIVER=local           # local | s3 (s3 = backlog)
OBJECT_STORE_ROOT=./data/uploads
UPLOAD_TTL_HOURS=24
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOC_MB=20

# --- AI providers -----------------------------------------------------
# replay = deterministik (dev/CI/demo offline). Lihat ADR-006.
LLM_PROVIDER=replay                 # replay | openai_compatible
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_DAILY_BUDGET_USD=1.00
LLM_REQUEST_TIMEOUT=45s

EMBEDDING_PROVIDER=hash             # hash | openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_BATCH=32

VLM_PROVIDER=off                    # off | openai_compatible
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# --- AI services (gRPC) ----------------------------------------------
RAG_GRPC_ADDR=localhost:9001
VISION_GRPC_ADDR=localhost:9002
VISION_TIMEOUT=30s
VISION_CONCURRENCY=1
VISION_BATCH_SIZE=8
VISION_BATCH_WAIT_MS=25

# --- Rate limit & queue ----------------------------------------------
RATE_LIMIT_PER_MIN=300
QUEUE_MAX_DEPTH=10

# --- Observability ----------------------------------------------------
TRACE_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=       # kosong = nonaktif (produksi hemat)

# --- Vision service ---------------------------------------------------
MODEL_DIR=/models
MODEL_VARIANT=int8                  # fp32 | fp16 | int8
MODEL_IMGSZ=960

# --- Frontend internal ------------------------------------------------
API_INTERNAL_URL=http://gateway:8080
